# Collapse is multi-server: everything below is process-wide, shared by every server the bot is in.
# Per-server settings (Rayward/Bloxlink API keys, mod role/channel, safety switches) are set by each
# server's own admins with /setup after the bot is invited and running - there is no GUILD_ID here.

# ---- Discord ----
DISCORD_TOKEN=

# ---- Secrets at rest ----
# Encrypts every server's Rayward/Bloxlink API keys before they're written to SQLite. Generate one with:
#     python -m banbot genkey
# Keep it secret and back it up - losing it means every server must run /setup again.
MASTER_KEY=

# ---- Rayward / Bloxlink hosts (shared; per-server API keys are set with /setup) ----
RAYWARD_BASE_URL=https://roscoe.rayward.app
ROBLOX_BASE_URL=https://users.roblox.com
# Avatar headshots attached to detection embeds. No key needed; a lookup failure just means the embed
# posts without a picture, never a delay or a block.
ROBLOX_THUMBNAILS_BASE_URL=https://thumbnails.roblox.com
# Switch the avatar pictures off (case embeds post without one).
ROBLOX_THUMBNAILS_ENABLED=true
# Switch every Roblox API call off (pictures included). Bloxlink-linked members are still checked, shown by
# Roblox id instead of username; members identified only by a "(@username)" nickname tag can't be checked.
ROBLOX_API_ENABLED=true
BLOXLINK_BASE_URL=https://api.blox.link
# One request per member (Bloxlink has no batch endpoint). 0.1 = about 10 lookups/second.
BLOXLINK_MIN_INTERVAL_S=0.1
# Bloxlink allows 2000 requests per day per server key. Each guild's sweep pauses at its own key's limit
# and continues after the UTC reset. RESERVE is held back from sweeps so member-join checks keep working.
BLOXLINK_DAILY_LIMIT=2000
BLOXLINK_DAILY_RESERVE=200

# ---- Batching / rate limits (shared by every server) ----
SWEEP_BATCH_SIZE=50
ROBLOX_BATCH_SIZE=100          # Roblox hard cap is 200
ROTECTOR_BATCH_SIZE=100        # Rayward hard cap is 100; used for every source
ROBLOX_MIN_INTERVAL_S=1.0
ROBLOX_THUMBNAIL_MIN_INTERVAL_S=1.0
ROTECTOR_MIN_INTERVAL_S=0.2
HTTP_TIMEOUT_S=15
HTTP_MAX_RETRIES=4
HTTP_BACKOFF_BASE_S=2
HTTP_BACKOFF_MAX_S=60
SWEEP_CHUNK_DELAY_S=2
BAN_DELAY_S=1

# ---- Inconclusive retries ----
RETRY_MAX_RETRIES=5
RETRY_BASE_DELAY_S=30
RETRY_MAX_DELAY_S=900
RETRY_POLL_INTERVAL_S=30

# ---- Message texts ----
# One file holding every editable message: the welcome post and the default ban DM, each under its own
# [section]. See the notes at the top of the file. Missing sections fall back to built-in text.
MESSAGES_FILE=messages.txt

# ---- Storage ----
DB_PATH=data/banbot.sqlite3
RAW_RETENTION_HOURS=24      # Rayward's terms allow at most 24; the cleanup runs every 10 minutes and acts early
# Days after the bot is removed from a server before everything stored about it is deleted. Its API keys are
# wiped straight away. See the privacy policy before changing this.
REMOVED_GUILD_RETENTION_DAYS=30
